{
  "name": "herdr-mcp",
  "version": "0.1.0",
  "description": "MCP server for Herdr: drive herdr-core terminals, agents, remote machines and the Herdr window from any MCP client",
  "type": "module",
  "license": "MIT",
  "author": "Kevin Wang <kevmo314@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevmo314/herdr-mcp.git"
  },
  "homepage": "https://github.com/kevmo314/herdr-mcp#readme",
  "bugs": {
    "url": "https://github.com/kevmo314/herdr-mcp/issues"
  },
  "keywords": ["mcp", "model-context-protocol", "herdr", "hc", "terminal", "agents"],
  "bin": {
    "herdr-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
